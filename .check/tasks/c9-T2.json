      ],
      "source": [
        {
          "has": "cache\\.get\\s*\\(",
          "msg": "t2.js does not ask the cache first: const kept = await cache.get(key);"
        },
        {
          "has": "cache\\.set\\s*\\(",
          "msg": "t2.js does not keep the number in the cache: await cache.set(key, n, \"EX\", 30);"
        },
        {
          "lacks": "(?:^|\\n)(?![^\\n]*await)[^\\n]*\\bcache\\.(get|set|del|incr|quit)\\(",
          "msg": "a call to the cache is not waited for: write await in front of it"
        }
      ],
      "cacheAfter": [
        {
          "key": "open:C",
          "equals": "2",
          "msg": "after the first request the cache should hold the key open:C with the value 2"
        },
        {
          "key": "open:C",
          "ttlMin": 1,
          "ttlMax": 30,
          "msg": "the key open:C should expire after 30 seconds: cache.set(key, n, \"EX\", 30)"
        }
      ]
