{
  "title": "Remove the key when the data changes",
  "parts": [
    {
      "kind": "serve",
      "file": "class-09/t3.js",
      "prefix": "chk_c9_",
      "db": "chk_c9_helpdesk",
      "seed": {
        "reports": [
          {
            "no": 1,
            "block": "C",
            "problem": "Wi-Fi down",
            "status": "open"
          },
          {
            "no": 2,
            "block": "A",
            "problem": "Fan not working",
            "status": "open"
          },
          {
            "no": 3,
            "block": "C",
            "problem": "Projector not working",
            "status": "closed"
          },
          {
            "no": 4,
            "block": "C",
            "problem": "Tap leaking",
            "status": "open"
          },
          {
            "no": 5,
            "block": "B",
            "problem": "Light flickering",
            "status": "closed"
          },
          {
            "no": 6,
            "block": "A",
            "problem": "Door jammed",
            "status": "closed"
          }
        ]
      },
      "cache": {},
      "ready": "/__ready",
      "requests": [
        {
          "path": "/open/C",
          "status": 200,
          "equals": "{\"block\":\"C\",\"open\":2,\"source\":\"database\"}",
          "msg": "the first request for Block C should come from the database with open 2"
        },
        {
          "path": "/open/C",
          "status": 200,
          "equals": "{\"block\":\"C\",\"open\":2,\"source\":\"cache\"}",
          "msg": "the second request for Block C should come from the cache"
        },
        {
          "method": "POST",
          "path": "/reports",
          "form": {
            "block": "C",
            "problem": "Lift stuck"
          },
          "status": 201,
          "has": [
            "Report stored for Block C"
          ],
          "msg": "a new report should be answered 201 Report stored for Block C"
        },
        {
          "path": "/open/C",
          "status": 200,
          "equals": "{\"block\":\"C\",\"open\":3,\"source\":\"database\"}",
          "msg": "after a new report for Block C the next answer must be the new number, 3, from the database: remove the key with cache.del(\"open:\" + req.body.block)"
        }
      ],
      "source": [
        {
          "has": "cache\\.del\\s*\\(",
          "msg": "t3.js does not remove the key: await cache.del(\"open:\" + req.body.block);"
        },
        {
          "lacks": "(?:^|\\n)(?![^\\n]*await)[^\\n]*\\bcache\\.(get|set|del|incr|quit)\\(",
          "msg": "a call to the cache is not waited for: write await in front of it"
        }
      ]
    }
  ]
}
